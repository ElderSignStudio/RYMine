// Cloudflare Pages configuration for the hosted read-only RYMine.
//
// Only read by @sveltejs/adapter-cloudflare (i.e. only when the build runs
// with ADAPTER=cloudflare). The default adapter-node build used by local dev
// and Render never looks at this file.
//
// NO SECRETS BELONG HERE. This file is committed. The Cloudflare deployment
// holds no write credentials at all — see docs/CLOUDFLARE_DEPLOYMENT.md.
//
// `nodejs_compat` is required because the readonly request path still uses
// node:crypto (timingSafeEqual / createHmac in the session helpers) and
// Buffer. A compatibility_date on or after 2025-04-01 additionally makes the
// Workers runtime populate `process.env` from the configured environment
// variables, which is how appMode.ts reads RYMINE_MODE and friends.
//
// `vars` are the RUNTIME variables handed to the Worker. They must live here
// rather than in the Pages dashboard: once a project has a Wrangler config,
// that file supersedes dashboard-set variables and bindings for Functions.
// The first deployment set them in the dashboard only and the Worker received
// none of them — it fell back to RYMINE_MODE=local and served mock data.
//
// BUILD-time variables are a separate channel and stay in the dashboard:
//   ADAPTER=cloudflare   (selects this adapter in svelte.config.js)
//   NODE_VERSION=22
// Putting those here would do nothing — `vars` reach the Worker, not the build.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rymine",
	"pages_build_output_dir": ".svelte-kit/cloudflare",
	"compatibility_date": "2025-09-23",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"RYMINE_MODE": "readonly",
		"RYMINE_PUBLIC_VIEWER": "1",
		"RYMINE_REMOTE_DATA_URL": "https://raw.githubusercontent.com/ElderSignStudio/RYMineData/main/data/wishlist.json",
		"RYMINE_REMOTE_DATA_CACHE_SECONDS": "300"
	}
}
